# Telegram Bot (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Admin Telegram user ID (get from @userinfobot)
ADMIN_TELEGRAM_ID=your_telegram_id_here

# Google Gemini API (get from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL (Railway provides this automatically)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Internal service URLs (Railway internal network)
AI_SERVICE_URL=http://ai-service.railway.internal:8001

# Webhook (your Railway bot service public URL)
WEBHOOK_BASE_URL=https://your-bot-service.up.railway.app

# Logging
LOG_LEVEL=INFO
